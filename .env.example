# Copie para apps/server/.env
DATABASE_URL=postgres://arkivo:arkivo@localhost:5433/arkivo
# Gere um valor aleatório longo em produção (ex.: openssl rand -hex 32)
JWT_SECRET=troque-este-segredo-em-producao
PORT=3000
# URL pública usada nos links de e-mail (convites, redefinição de senha)
PUBLIC_URL=http://localhost:5173
# Pasta dos arquivos enviados (imagens, originais importados)
STORAGE_DIR=./data/uploads
# Conversão de arquivos do Office em PDF (visualização fiel ao original). Deixe vazio para desativar.
GOTENBERG_URL=http://localhost:3001
